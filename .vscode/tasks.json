{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar e Rodar Java",
            "type": "shell",
            "command": "& { $file='${file}'; $name=[System.IO.Path]::GetFileNameWithoutExtension($file); javac -d bin \"$file\"; java -cp bin $name }",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "shell": {
                    "executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
                }
            }
        }
    ]
}
